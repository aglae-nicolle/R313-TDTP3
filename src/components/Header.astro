---
import SpeciesSelect from "../components/SpeciesSelect.astro";
import penguins from "../assets/penguins.json";

const species = [...new Set(penguins.map((p) => p.species))];

const match = Astro.url.pathname.match(/^\/species\/([^/]+)/);
const current = match ? decodeURIComponent(match[1]) : "";
---

<nav class="flex gap-4 p-4 border-b">
    <SpeciesSelect species={species} current={current} />
</nav>
