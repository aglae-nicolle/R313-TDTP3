---
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";
import penguins from "../assets/penguins.json";

interface Props {
    species?: string;
}
const { species } = Astro.props;

const data = (
    species ? penguins.filter((p) => p.species === species) : penguins
).filter((p) => p.culmen_length_mm != null && p.culmen_depth_mm != null);

const { document } = new JSDOM("").window;

const chart = Plot.plot({
    document,
    grid: true,
    marginLeft: 50,
    width: 800,
    color: { legend: !species, domain: ["Adelie", "Chinstrap", "Gentoo"] },
    x: { label: "Longueur du bec (mm)" },
    y: { label: "Profondeur du bec (mm)" },
    marks: [
        Plot.dot(data, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            fill: "species",
            r: 4,
            tip: true,
        }),
    ],
});
---

<figure set:html={chart.outerHTML} />
