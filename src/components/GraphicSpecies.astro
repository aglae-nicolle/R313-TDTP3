---
import * as Plot from "@observablehq/plot";
import PlotFigure from "./PlotFigure.astro";
import penguins from "../assets/penguins.json";

interface Props {
    data?: typeof penguins;
    species?: string;
}

const { data: dataProp, species } = Astro.props;
const asked = species ?? (typeof dataProp === "string" ? dataProp : undefined);

const data = Array.isArray(dataProp)
    ? dataProp
    : !asked || asked === "Toutes"
      ? penguins
      : penguins.filter((p) => p.species === asked);
---

<PlotFigure
    options={{
        marks: [
            Plot.dot(data, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
            }),
        ],
    }}
/>
