---
import Layout from "../layouts/Layout.astro";
import GraphicSpecies from "../components/GraphicSpecies.astro";

const speciesList = ["Adelie", "Gentoo", "Chinstrap"];
---

<Layout title="Manchots : vue par ancres">
  <label for="anchors">Aller à</label>
  <select id="anchors">
    <option value="#Toutes">Toutes</option>
    {speciesList.map((s) => <option value={`#${s}`}>{s}</option>)}
  </select>

  <section
    id="Toutes"
    class="flex min-h-screen scroll-mt-20 flex-col justify-center py-10"
  >
    <h2 class="mb-6 text-3xl font-bold">Toutes les espèces</h2>
    <GraphicSpecies />
  </section>

  {
    speciesList.map((s) => (
      <section
        id={s}
        class="flex min-h-screen scroll-mt-20 flex-col justify-center py-10"
      >
        <h2 class="mb-6 text-3xl font-bold">{s}</h2>
        <GraphicSpecies species={s} />
      </section>
    ))
  }

  <script>
    const select = document.querySelector("#anchors");

    select?.addEventListener("change", (evt) => {
      const value = (evt.target as HTMLSelectElement).value;
      location.hash = value;
    });

    if (select instanceof HTMLSelectElement && location.hash) {
      select.value = location.hash;
    }
  </script>
</Layout>
