---
import Layout from "../layouts/Layout.astro";
import GraphicSpecies from "../components/GraphicSpecies.astro";
import penguins from "../assets/penguins.json";
import {
  Tabs,
  TabsList,
  TabsTab,
  TabsPanel,
} from "accessible-astro-components";

const names = ["Adelie", "Chinstrap", "Gentoo"] as const;
const bySpecies = Object.fromEntries(
  names.map((name) => [name, penguins.filter((p) => p.species === name)]),
);
---

<Layout>
  <h1 class="mb-4 text-2xl">Espèces par onglets</h1>

  <Tabs>
    <TabsList class="flex! gap-2!">
      {
        names.map((name, index) => (
          <TabsTab
            id={`tab-${name}`}
            controls={`panel-${name}`}
            selected={index === 0}
            class="rounded-t-md border border-slate-300 bg-white px-4! py-2! aria-selected:bg-slate-900! aria-selected:text-white!"
          >
            {name}
          </TabsTab>
        ))
      }
    </TabsList>

    {
      names.map((name, index) => (
        <TabsPanel
          id={`panel-${name}`}
          labelledby={`tab-${name}`}
          selected={index === 0}
          class="rounded-b-md border border-slate-300 p-4!"
        >
          <h2 class="text-xl">{name}</h2>
          <GraphicSpecies data={bySpecies[name]} />
        </TabsPanel>
      ))
    }
  </Tabs>
</Layout>
